# Environment variables for Entropy Zero Frontend

# Official-style names correspond to NEXT_PUBLIC_* in SPA templates; under Vite use VITE_ prefix:

VITE_SUPABASE_URL=your_supabase_project_url

# Equivalent to SUPABASE_ANON_KEY (publishable / anon JWT)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

VITE_API_BASE_URL=http://localhost:8173/api

# DEV_JWT_PAIRING:
# VITE_DEV_ACCESS_TOKEN=

# VITE_API_DISABLED=
