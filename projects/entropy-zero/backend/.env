# SUPABASE_SERVICE_KEY=your_service_role_key_here
# UPSTASH_REDIS_URL=your_upstash_redis_url_here

# AI Service (OpenRouter / OpenAI / Anthropic)
AI_API_KEY=sk_test_placeholder

# Python Environment
PYTHONPATH=.
