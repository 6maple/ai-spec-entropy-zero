# Entropy Zero Backend Environment Variables

# === LOCAL DEVELOPMENT (SQLite - no installation needed) ===
# Uncomment for local development:
DATABASE_URL=postgresql+asyncpg://postgres:admzyi@localhost:5432/entropy_zero
# REDIS_URL=redis://localhost:6379  # Optional, for task queue

# === PRODUCTION (Supabase + Upstash) ===
# Uncomment these for deployment:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_here
# UPSTASH_REDIS_URL=your_upstash_redis_url_here

# AI Service (OpenRouter / OpenAI / Anthropic)
AI_API_KEY=sk_test_placeholder

# 本地开发 JWT（需与 frontend/.env.development.local 中 VITE_DEV_ACCESS_TOKEN 配套）
DEV_JWT_SECRET=entropy-dev-jwt-secret-32-characters!!

# Python Environment
PYTHONPATH=.
