# Entropy Zero Backend Environment Variables

# === LOCAL DEVELOPMENT (SQLite - no installation needed) ===
# Uncomment for local development:
DATABASE_URL=sqlite+aiosqlite:///./entropy_zero.db
REDIS_URL=redis://localhost:6379

# 本地 JWT（与前端 VITE_DEV_ACCESS_TOKEN 使用同一密钥签发；生产请改用 SUPABASE_JWT_SECRET）
# DEV_JWT_SECRET=entropy-dev-jwt-secret-32-characters!!
# 无 Redis 时仅本地验证：在 API 进程内异步跑 worker（勿用于生产）
# ENTROPY_INLINE_QUEUE=1

# === PRODUCTION (Supabase + Upstash) ===
# Uncomment these for deployment:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_here
# UPSTASH_REDIS_URL=your_upstash_redis_url_here

# === AI Agent（知识处理主路径，默认开启） ===
# 中文抽取/路由/语言检测依赖 DashScope 兼容端点。真实密钥请写在同目录 .env.local（已 gitignore，勿提交）
ENTROPY_AGENT=1
DASHSCOPE_API_KEY=
# 英文等路径可选用 Gemini
AI_API_KEY=sk_test_placeholder
# GEMINI_API_KEY is optional when source docs are Chinese only
GEMINI_API_KEY=
AI_MAX_TOKENS=4096

# Python Environment
PYTHONPATH=.
