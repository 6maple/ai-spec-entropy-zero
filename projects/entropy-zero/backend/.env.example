# Entropy Zero Backend — 密钥放 backend/.env.local

# -----------------------------------------------------------------------------
# Supabase Python（Data API：https://supabase.com/docs/reference/python/introduction）
# 使用 create_client 时仅需项目 URL + API 密钥，无需单独的数据库登录密码变量。
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=<API Keys → Secret>
# SUPABASE_JWT_SECRET=<用于后端校验 Bearer，与 JWT 签名一致>

# -----------------------------------------------------------------------------
# SQLAlchemy 直连（本仓库 ORM / Worker）：仅当配置了 DATABASE_URL 时启用；
# 与官方 Supabase Python 客户端必填项无关，常为本地 SQLite 或 Connect 复制的 Postgres URI。
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./entropy_zero.db

AUTH_MODE=supabase

REDIS_URL=redis://localhost:6379

ENTROPY_AGENT=1
DASHSCOPE_API_KEY=
AI_API_KEY=sk_test_placeholder
GEMINI_API_KEY=
AI_MAX_TOKENS=4096

PYTHONPATH=.
